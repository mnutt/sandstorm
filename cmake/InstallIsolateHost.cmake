function(check_hash path expected)
  file(SHA256 "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "isolate-host checksum mismatch: ${path}")
  endif()
endfunction()

if(NOT LOCAL_OVERRIDE)
  check_hash("${ARCHIVE}" "${ARCHIVE_SHA256}")
  if(NOT VERIFY_ONLY)
    file(REMOVE_RECURSE "${RELEASE_DIR}")
    file(MAKE_DIRECTORY "${RELEASE_DIR}")
    file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${RELEASE_DIR}")
  endif()
  check_hash("${SOURCE}" "${BINARY_SHA256}")
else()
  file(SHA256 "${SOURCE}" BINARY_SHA256)
endif()

if(NOT VERIFY_ONLY)
  get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_dir}")
  configure_file("${SOURCE}" "${OUTPUT}.new" COPYONLY)
  file(CHMOD "${OUTPUT}.new" PERMISSIONS
    OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  file(RENAME "${OUTPUT}.new" "${OUTPUT}")
endif()
check_hash("${OUTPUT}" "${BINARY_SHA256}")
