+KJ_TEST("UI requests require matching origins or same-origin fetch metadata") {
+  GatewayFixture fixture;
+  auto check = [&](kj::StringPtr origin, kj::StringPtr site, uint status) {
+    kj::HttpHeaders headers(*fixture.headerTable);
+    headers.set(kj::HttpHeaderId::HOST, "ui-test.example");
+    headers.set(fixture.requestCookie, "sandstorm-sid=test-session");
+    if (origin.size() > 0) headers.set(fixture.origin, origin);
+    if (site.size() > 0) headers.set(fixture.fetchSite, site);
+    auto request = fixture.client->request(kj::HttpMethod::POST, "/", headers, uint64_t(0));
+    request.body = nullptr;
+    auto response = request.response.wait(fixture.io.waitScope);
+    KJ_EXPECT(response.statusCode == status, origin, site);
+    response.body->readAllText().wait(fixture.io.waitScope);
+  };
+  check("http://ui-test.example", "", 204);
+  check("", "", 204);
+  check("http://other.example", "same-origin", 403);
+  check("null", "", 403);
+  check("null", "cross-site", 403);
+  check("null", "same-site", 403);
+  check("null", "none", 403);
+  check("null", "same-origin", 204);
+}
