+// A binary message channel supplied directly by an in-process embedder. The channel is deliberately
+// not serializable and is intended for native protocols such as Cap'n Proto RPC.
+class NativeByteChannelEndpoint {
+ public:
+  virtual ~NativeByteChannelEndpoint() noexcept(false) = default;
+  virtual void send(kj::Array<kj::byte> message) = 0;
+  virtual kj::Promise<kj::Array<kj::byte>> receive() = 0;
+  virtual void close() = 0;
+};
+
+class NativeByteChannelProvider: public kj::AtomicRefcounted {
+ public:
+  virtual ~NativeByteChannelProvider() noexcept(false) = default;
+  virtual kj::Own<NativeByteChannelEndpoint> open() = 0;
+};
+
+class NativeByteChannel final: public jsg::Object {
+ public:
+  explicit NativeByteChannel(kj::Own<NativeByteChannelEndpoint> endpoint)
+      : endpoint(kj::mv(endpoint)) {}
+
+  void send(jsg::Lock& js, jsg::BufferSource message);
+  jsg::Promise<jsg::BufferSource> receive(jsg::Lock& js);
+  void close();
+
+  JSG_RESOURCE_TYPE(NativeByteChannel) {
+    JSG_METHOD(send);
+    JSG_METHOD(receive);
+    JSG_METHOD(close);
+  }
+
+ private:
+  kj::Maybe<kj::Own<NativeByteChannelEndpoint>> endpoint;
+};
+
+class NativeByteChannelFactory final: public jsg::Object {
+ public:
