+// same isolate group. The channel deliberately has no serialization support.
+class LocalBufferChannelEndpoint {
+ public:
+  virtual ~LocalBufferChannelEndpoint() noexcept(false) = default;
+  virtual void send(jsg::BackingStore buffer) = 0;
+  virtual kj::Promise<jsg::BackingStore> receive() = 0;
+  virtual void close() = 0;
+};
+
+class LocalBufferChannelProvider: public kj::AtomicRefcounted {
+ public:
+  virtual ~LocalBufferChannelProvider() noexcept(false) = default;
+  virtual kj::Own<LocalBufferChannelEndpoint> take(kj::StringPtr name) = 0;
+};
