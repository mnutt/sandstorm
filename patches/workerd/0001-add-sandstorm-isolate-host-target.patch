+bool writeStructuredWorkerLog(
+    const Worker::LoggingOptions& loggingOptions, LogLevel level, kj::StringPtr message) {
+  if (!loggingOptions.structuredLogging.toBool() ||
+      loggingOptions.consoleMode != Worker::ConsoleMode::STDOUT) {
+    return false;
+  }
+
+  capnp::JsonCodec json;
+  auto timestamp =
+      (kj::systemPreciseCalendarClock().now() - kj::UNIX_EPOCH) / kj::MILLISECONDS;
+  auto record = kj::str(
+      "{\"timestamp\":", timestamp,
+      ",\"level\":", json.encode(capnp::Text::Reader(logLevelToString(level))),
+      ",\"message\":", json.encode(capnp::Text::Reader(message)),
+      ",\"worker\":", json.encode(capnp::Text::Reader(loggingOptions.workerName)),
+      "}\n");
+  fwrite(record.begin(), 1, record.size(), stdout);
+  fflush(stdout);
+  return true;
+}
