 namespace workerd::api {
 
+void NativeByteChannel::send(jsg::Lock& js, jsg::BufferSource message) {
+  auto& active = JSG_REQUIRE_NONNULL(endpoint, Error, "Native byte channel is closed");
+  auto backing = message.detach(js);
+  auto bytes = kj::heapArray<kj::byte>(backing.size());
+  bytes.asPtr().copyFrom(backing.asArrayPtr<const kj::byte>());
+  active->send(kj::mv(bytes));
+}
+
+jsg::Promise<jsg::BufferSource> NativeByteChannel::receive(jsg::Lock& js) {
+  auto& active = JSG_REQUIRE_NONNULL(endpoint, Error, "Native byte channel is closed");
+  return IoContext::current().awaitIo(js, active->receive(),
+      [](jsg::Lock& js, kj::Array<kj::byte> message) {
+    return jsg::BufferSource(js, jsg::BackingStore::from(js, kj::mv(message)));
+  });
+}
+
+void NativeByteChannel::close() {
+  KJ_IF_SOME(active, endpoint) {
+    active->close();
+    endpoint = kj::none;
+  }
+}
+
+jsg::Ref<NativeByteChannel> NativeByteChannelFactory::open(jsg::Lock& js) {
+  return js.alloc<NativeByteChannel>(provider->open());
+}
