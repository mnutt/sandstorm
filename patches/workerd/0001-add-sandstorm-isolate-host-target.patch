+void LocalBufferChannel::send(jsg::Lock& js, jsg::BufferSource buffer) {
+  JSG_REQUIRE(buffer.canDetach(js), DOMDataCloneError,
+      "Local buffer channels require a detachable ArrayBuffer");
+  auto& active = JSG_REQUIRE_NONNULL(endpoint, Error, "Local buffer channel is closed");
+  active->send(buffer.detach(js));
+}
+
+jsg::Promise<jsg::BufferSource> LocalBufferChannel::receive(jsg::Lock& js) {
+  auto& active = JSG_REQUIRE_NONNULL(endpoint, Error, "Local buffer channel is closed");
+  return IoContext::current().awaitIo(js, active->receive(),
+      [](jsg::Lock& js, jsg::BackingStore buffer) {
+    return jsg::BufferSource(js, kj::mv(buffer));
+  });
+}
+
+void LocalBufferChannel::close() {
+  KJ_IF_SOME(active, endpoint) {
+    active->close();
+    endpoint = kj::none;
+  }
+}
+
+jsg::Ref<LocalBufferChannel> LocalBufferChannelBroker::accept(
+    jsg::Lock& js, kj::String name) {
+  return js.alloc<LocalBufferChannel>(provider->take(name));
+}
