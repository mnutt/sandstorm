+
+  jsg::Ref<NativeByteChannel> open(jsg::Lock& js);
+
+  JSG_RESOURCE_TYPE(NativeByteChannelFactory) {
+    JSG_METHOD(open);
+  }
+
+ private:
+  kj::Own<NativeByteChannelProvider> provider;
+};
