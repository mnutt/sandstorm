{
  "name": "sandstorm-rust-shell-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "mkdir -p src/generated && capnp compile -I../schema --src-prefix=../schema -o./node_modules/.bin/capnpc-ts:src/generated ../schema/shell.capnp ../schema/fixture.capnp",
    "check": "npm run generate && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.public.json",
    "build": "npm run generate && vite build",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run generate && vite"
  },
  "dependencies": {
    "bits-ui": "2.21.0",
    "capnp-es": "npm:@mnutt/capnp-es@0.5.0",
    "svelte": "5.58.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "svelte-check": "4.4.2",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
