#!/usr/bin/env bash

set -euo pipefail

input="sandstorm/isolate/api.js"
browser_input="sandstorm/isolate/browser-client.js"
validation_input="sandstorm/isolate/validation.js"
output="sandstorm/isolate/api.js.h"

if test $# = 0; then
  echo "trigger canonical:${input}"
  exit 0
fi

echo "findInput ${input}"
read INPUT_DISK_FILE
echo "findInput ${browser_input}"
read BROWSER_INPUT_DISK_FILE
echo "findInput ${validation_input}"
read VALIDATION_INPUT_DISK_FILE

echo "newOutput ${output}"
read OUTPUT_DISK_FILE

python3 - "$INPUT_DISK_FILE" "$BROWSER_INPUT_DISK_FILE" \
    "$VALIDATION_INPUT_DISK_FILE" "$OUTPUT_DISK_FILE" <<'PY'
import json
import sys

input_path, browser_input_path, validation_input_path, output_path = sys.argv[1:]
with open(input_path, "rb") as f:
    data = f.read()
with open(browser_input_path, "r", encoding="utf-8") as f:
    browser_source = f.read()
with open(validation_input_path, "rb") as f:
    validation_data = f.read()

marker = b'"__SANDSTORM_BROWSER_CLIENT_SOURCE__"'
replacement = json.dumps(browser_source, ensure_ascii=True).encode("ascii")
if data.count(marker) != 1:
    raise RuntimeError("api.js browser client source marker must occur exactly once")
data = data.replace(marker, replacement)

def escape_chunk(chunk):
    out = []
    for b in chunk:
        if b == 0x0a:
            out.append(r"\n")
        elif b == 0x0d:
            out.append(r"\r")
        elif b == 0x09:
            out.append(r"\t")
        elif b == 0x22:
            out.append(r"\"")
        elif b == 0x5c:
            out.append(r"\\")
        elif 0x20 <= b <= 0x7e:
            out.append(chr(b))
        else:
            out.append("\\x%02x" % b)
    return "".join(out)

with open(output_path, "w", encoding="utf-8") as out:
    out.write("// Generated from isolate JavaScript sources. Do not edit.\n")
    out.write("#pragma once\n\n")
    out.write("namespace sandstorm {\n")
    def write_source(name, source):
        out.write(f"static constexpr const char {name}[] =\n")
        for i in range(0, len(source), 100):
            out.write("    \"")
            out.write(escape_chunk(source[i:i + 100]))
            out.write("\"\n")
        out.write("    ;\n")
    write_source("ISOLATE_API_HELPER_SOURCE", data)
    write_source("ISOLATE_VALIDATION_HELPER_SOURCE", validation_data)
    out.write("}  // namespace sandstorm\n")
PY
