#!/usr/bin/env bash

set -euo pipefail

input="sandstorm/isolate/capnweb.js"
output="sandstorm/isolate/capnweb.js.h"

if test $# = 0; then
  echo "trigger canonical:${input}"
  exit 0
fi

echo "findInput ${input}"
read INPUT_DISK_FILE

echo "newOutput ${output}"
read OUTPUT_DISK_FILE

python3 - "$INPUT_DISK_FILE" "$OUTPUT_DISK_FILE" <<'PY'
import sys

input_path, output_path = sys.argv[1], sys.argv[2]
with open(input_path, "rb") as f:
    data = f.read()

def escape_chunk(chunk):
    out = []
    for b in chunk:
        if b == 0x0a:
            out.append(r"\n")
        elif b == 0x0d:
            out.append(r"\r")
        elif b == 0x09:
            out.append(r"\t")
        elif b == 0x22:
            out.append(r"\"")
        elif b == 0x5c:
            out.append(r"\\")
        elif 0x20 <= b <= 0x7e:
            out.append(chr(b))
        else:
            out.append("\\x%02x" % b)
    return "".join(out)

with open(output_path, "w", encoding="utf-8") as out:
    out.write("// Generated from src/sandstorm/isolate/capnweb.js. Do not edit.\n")
    out.write("#pragma once\n\n")
    out.write("namespace sandstorm {\n")
    out.write("static constexpr const char CAPNWEB_SOURCE[] =\n")
    for i in range(0, len(data), 100):
        out.write("    \"")
        out.write(escape_chunk(data[i:i + 100]))
        out.write("\"\n")
    out.write("    ;\n")
    out.write("}  // namespace sandstorm\n")
PY
